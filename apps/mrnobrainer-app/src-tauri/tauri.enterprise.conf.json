{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MRnObrainer",
  "identifier": "screenpi.pe.enterprise",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "active": true,
    "publisher": "Mediar, Inc.",
    "category": "DeveloperTool",
    "shortDescription": "Action-first memory for your desktop",
    "longDescription": "MRnObrainer keeps your captured day local, makes it searchable, and helps you close it out with a clearer dashboard and recap.",
    "copyright": "",
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "nsis"
    ],
    "externalBin": [
      "bun"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/screenpipe-logo-tray-failed.png",
      "icons/screenpipe-logo-tray-black.png"
    ],
    "resources": [
      "assets/*"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "signCommand": "powershell -ExecutionPolicy Bypass -File sign-enterprise.ps1 %1",
      "nsis": {
        "installMode": "perMachine",
        "headerImage": "assets/nsis-header.bmp",
        "sidebarImage": "assets/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "mrnobrainer",
          "screenpipe"
        ]
      },
      "mobile": [
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/auth"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/stripe-connect"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/purchase-successful"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/settings"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/changelog"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/onboarding"
          ]
        },
        {
          "host": "screenpi.pe",
          "pathPrefix": [
            "/status"
          ]
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": {
      "id": "screenpipe_main",
      "iconPath": "assets/screenpipe-logo-tray-white.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true
    },
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCONFIG/**",
          "$RESOURCE/**",
          "$TEMP/**",
          "$HOME/.screenpipe/**"
        ]
      },
      "csp": "default-src 'self' asset: data: blob: http://ipc.localhost; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: http://localhost:* http://127.0.0.1:* https:; font-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https://screenpi.pe https://api.screenpi.pe https://api.openai.com https://*.openai.com https://auth.openai.com https://api.github.com; media-src 'self' asset: data: blob: http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:;"
    },
    "macOSPrivateApi": true
  }
}
